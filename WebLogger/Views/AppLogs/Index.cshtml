@model AppLogsFilterViewModel
@using System.Security.Claims

<h2>App Logs</h2>

<!-- Wylogowanie -->
<form asp-controller="Account" asp-action="Logout" method="post" class="mb-2">
    <button type="submit" class="btn btn-danger">Logout</button>
</form>


<form asp-controller="AppLogs" asp-action="Index" method="get" class="mb-4">
    <div class="form-group">
        <label>App Name:</label>
        <input type="text" name="searchString" value="@Model.SearchString" class="form-control" />
    </div>
    <div class="form-group">
        <label>Log Type:</label>
        <input type="text" name="logtype" value="@Model.LogType" class="form-control" />
    </div>
    <div class="form-group">
        <label>From:</label>
        <input type="date" name="from" value="@Model.From?.ToString(" yyyy-MM-dd")" class="form-control" />
    </div>
    <div class="form-group">
        <label>To:</label>
        <input type="date" name="to" value="@Model.To?.ToString(" yyyy-MM-dd")" class="form-control" />
    </div>
    <button type="submit" class="btn btn-outline-primary mt-2">Filter</button>
</form>

<!-- Akcje -->
<div class="mb-3">
    @if (User.IsInRole("Administrator")){
        <a asp-action="Create" class="btn btn-success">Create New Log</a>
    }

    <form asp-action="AddDaily" method="post" class="d-inline">

        <button type="submit" class="btn btn-primary">Add Daily Log</button>
    </form>

    <form asp-action="Refresh" method="post" class="d-inline">

        <button type="submit" class="btn btn-warning">Refresh Logs</button>
    </form>
</div>

<!-- Tabela z logami -->
<table class="table table-striped">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Logs[0].AppName)</th>
            <th>@Html.DisplayNameFor(model => model.Logs[0].DateTime)</th>
            <th>@Html.DisplayNameFor(model => model.Logs[0].LogType)</th>
            <th>@Html.DisplayNameFor(model => model.Logs[0].Content)</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Logs)
        {
            <tr>
                <td>@item.AppName</td>
                <td>@item.DateTime</td>
                <td>@item.LogType</td>
                <td>@item.Content</td>
                <td>
                    @if (User.IsInRole("Administrator"))
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Delete</a>
                    }
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                </td>
            </tr>
        }
    </tbody>
</table>
